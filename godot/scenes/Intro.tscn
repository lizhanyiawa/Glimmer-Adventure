[gd_scene load_steps=2 format=3]

; 开场引导（跑码 → 标题）。界面在 scripts/ui/intro.gd 里用代码搭，
; 这里只留一个铺满屏幕的根节点，方便改布局时不用碰 tscn 格式。

[ext_resource type="Script" path="res://scripts/ui/intro.gd" id="1_intro"]

[node name="Intro" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_intro")
