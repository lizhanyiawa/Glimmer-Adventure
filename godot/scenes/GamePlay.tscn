[gd_scene load_steps=13 format=3]

; 主玩法画面（渲染层第一版草案）
; 布局对应 view/game_menu.py 的 GamePlayScreen：
;   状态栏(HP/SAN + 位置 + 属性) / 主视口(故事框 + 历史 + 追踪任务) / 底部(6 选项 + 系统按钮)
; 场景里填的是占位数据，运行时由 scripts/ui/game_play.gd 全部覆盖为引擎里的真实数据。

[ext_resource type="Script" path="res://scripts/ui/game_play.gd" id="1_gameplay"]

