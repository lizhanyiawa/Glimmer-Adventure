[gd_scene load_steps=8 format=3]

; ── 通用模态弹窗 ──
; 一套外壳，吃下原项目 6 个 Screen：
;   profile_screen / inventory_screen / save_game_screen
;   load_game_screen / equipment_screen / global_settings
; 它们的差异只有两处：中间内容(Body) 和 底部按钮(Footer)。
; 外壳结构固定：遮罩(Dim) → 居中面板(Frame) → 标题 + 内容区 + 按钮区。
;
; Body 与 Footer 都是空容器，留给脚本运行时填充（第三步接 GDScript）。
; 本版为「硬编码样例」，用 profile_screen 的字段填了一份真实内容，
; 只用于确认弹窗的尺寸、边框、配色与按钮态，未接入引擎逻辑。
;
; 脚本接入后需要改动的地方（按界面）：
;   标题文字 / 标题颜色 ← Profile #ff007f / Save #ffaa00 / Load #00ff66
;                          Equipment #ddaa00 / Inventory #66fcf1 / Settings #ffaa00
;   边框颜色           ← 同上（改 Frame 的 panel StyleBox 的 border_color）
;   面板宽度           ← 默认 640，Inventory / Equipment 原为 72 字符宽(最宽)
;   内容区高度         ← 默认 220，Inventory 原为 24 行(更高)

[ext_resource type="Script" path="res://scripts/ui/modal.gd" id="1_modal"]

[sub_resource type="SystemFont" id="SystemFont_cjk"]
font_names = PackedStringArray("Microsoft YaHei UI", "Microsoft YaHei", "SimHei", "Noto Sans CJK SC", "sans-serif")

[sub_resource type="Theme" id="Theme_main"]
default_font = SubResource("SystemFont_cjk")
default_font_size = 16

[sub_resource type="StyleBoxFlat" id="SB_frame"]
bg_color = Color(0.086275, 0.098039, 0.137255, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0, 0.498039, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="SB_btn"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0
bg_color = Color(0.137255, 0.156863, 0.231373, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="SB_btn_hover"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0
bg_color = Color(1, 0.666667, 0, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="SB_btn_disabled"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0
bg_color = Color(0.066667, 0.066667, 0.066667, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="Modal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = SubResource("Theme_main")
script = ExtResource("1_modal")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.72)

[node name="Center" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Frame" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(640, 0)
layout_mode = 2
theme_override_styles/panel = SubResource("SB_frame")

[node name="Margin" type="MarginContainer" parent="Center/Frame"]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Center/Frame/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Center/Frame/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0, 0.498039, 1)
theme_override_font_sizes/font_size = 18
text = "人物详情"
horizontal_alignment = 1

[node name="BodyScroll" type="ScrollContainer" parent="Center/Frame/Margin/VBox"]
custom_minimum_size = Vector2(0, 220)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Center/Frame/Margin/VBox/BodyScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 6

[node name="BodyText" type="RichTextLabel" parent="Center/Frame/Margin/VBox/BodyScroll/Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.698039, 0.698039, 0.698039, 1)
bbcode_enabled = true
text = "名字: 无名
生命: 78/100
理智: 64
污染: 3

[color=#ff007f][b]—— 属性 ——[/b][/color]
攻击: 12
防御: 8
智力: 14
敏捷: 11"
fit_content = true
scroll_active = false

[node name="Footer" type="VBoxContainer" parent="Center/Frame/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="BtnEquip" type="Button" parent="Center/Frame/Margin/VBox/Footer"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_override_colors/font_color = Color(0.866667, 0.666667, 0, 1)
theme_override_colors/font_hover_color = Color(0.043137, 0.047059, 0.062745, 1)
theme_override_colors/font_pressed_color = Color(0.043137, 0.047059, 0.062745, 1)
theme_override_colors/font_disabled_color = Color(0.2, 0.2, 0.2, 1)
theme_override_styles/normal = SubResource("SB_btn")
theme_override_styles/hover = SubResource("SB_btn_hover")
theme_override_styles/pressed = SubResource("SB_btn_hover")
theme_override_styles/focus = SubResource("SB_btn")
theme_override_styles/disabled = SubResource("SB_btn_disabled")
text = "[E] 装备"

[node name="BtnClose" type="Button" parent="Center/Frame/Margin/VBox/Footer"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(0.043137, 0.047059, 0.062745, 1)
theme_override_colors/font_pressed_color = Color(0.043137, 0.047059, 0.062745, 1)
theme_override_colors/font_disabled_color = Color(0.2, 0.2, 0.2, 1)
theme_override_styles/normal = SubResource("SB_btn")
theme_override_styles/hover = SubResource("SB_btn_hover")
theme_override_styles/pressed = SubResource("SB_btn_hover")
theme_override_styles/focus = SubResource("SB_btn")
theme_override_styles/disabled = SubResource("SB_btn_disabled")
text = "[ESC] 关闭"