[gd_scene load_steps=7 format=3]

; ── 通用面板外壳 ──
; 一套外壳，吃下所有界面：人物 / 物品 / 装备 / 保存 / 读取 / 设置 / 商店 / 日记
; 以及确认框、新建笔记。它们的差异只有两处：中间内容(Body) 和 底部按钮(Footer)。
;
; 结构固定：遮罩(Dim) → 舞台(Stage) → 面板(Frame) → 标题 + 内容区 + 按钮区。
; Body 与 Footer 都是空容器，留给脚本运行时填充（scripts/ui/modal.gd）。
;
; 面板有两种摆法，由脚本按 mode 决定（Stage 是中性容器，不参与定位）：
;   MODE_CENTER（居中弹窗）—— 确认框 / 输入框，锚点居中、尺寸随内容
;   MODE_DRAWER（右侧抽屉）—— 人物 / 物品 / 设置等主面板，贴右侧、撑满整高、滑入滑出
; 这里预置的是「居中」锚点，运行时会按 mode 重写。

[ext_resource type="Script" path="res://scripts/ui/modal.gd" id="1_modal"]

[sub_resource type="StyleBoxFlat" id="SB_frame"]
bg_color = Color(0.086275, 0.098039, 0.137255, 1)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1, 0, 0.498039, 1)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="SB_btn"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0
bg_color = Color(0.137255, 0.156863, 0.231373, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="SB_btn_hover"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0
bg_color = Color(1, 0.666667, 0, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[sub_resource type="StyleBoxFlat" id="SB_btn_disabled"]
content_margin_left = 10.0
content_margin_top = 6.0
content_margin_right = 10.0
content_margin_bottom = 6.0
bg_color = Color(0.066667, 0.066667, 0.066667, 1)
corner_radius_top_left = 3
corner_radius_top_right = 3
corner_radius_bottom_right = 3
corner_radius_bottom_left = 3

[node name="Modal" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_modal")

[node name="Dim" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.72)

; 中性舞台：只负责铺满整屏，定位全部交给脚本写在 Frame 的锚点上，
; 这样同一个 Frame 既能居中（确认框），也能贴右撑满（抽屉）。
[node name="Stage" type="Control" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Frame" type="PanelContainer" parent="Stage"]
custom_minimum_size = Vector2(640, 0)
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("SB_frame")

[node name="Margin" type="MarginContainer" parent="Stage/Frame"]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 18
theme_override_constants/margin_bottom = 16

[node name="VBox" type="VBoxContainer" parent="Stage/Frame/Margin"]
layout_mode = 2
theme_override_constants/separation = 14

[node name="Title" type="Label" parent="Stage/Frame/Margin/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0, 0.498039, 1)
theme_type_variation = &"Heading"
text = "人物详情"
horizontal_alignment = 1

[node name="BodyScroll" type="ScrollContainer" parent="Stage/Frame/Margin/VBox"]
custom_minimum_size = Vector2(0, 220)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="Body" type="VBoxContainer" parent="Stage/Frame/Margin/VBox/BodyScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
theme_override_constants/separation = 6

[node name="BodyText" type="RichTextLabel" parent="Stage/Frame/Margin/VBox/BodyScroll/Body"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/default_color = Color(0.698039, 0.698039, 0.698039, 1)
bbcode_enabled = true
text = "名字: 无名
生命: 78/100
理智: 64
污染: 3

[color=#ff007f][b]—— 属性 ——[/b][/color]
攻击: 12
防御: 8
智力: 14
敏捷: 11"
fit_content = true
scroll_active = false

[node name="Footer" type="VBoxContainer" parent="Stage/Frame/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="BtnEquip" type="Button" parent="Stage/Frame/Margin/VBox/Footer"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_override_colors/font_color = Color(0.866667, 0.666667, 0, 1)
theme_override_colors/font_hover_color = Color(0.043137, 0.047059, 0.062745, 1)
theme_override_colors/font_pressed_color = Color(0.043137, 0.047059, 0.062745, 1)
theme_override_colors/font_disabled_color = Color(0.2, 0.2, 0.2, 1)
theme_override_styles/normal = SubResource("SB_btn")
theme_override_styles/hover = SubResource("SB_btn_hover")
theme_override_styles/pressed = SubResource("SB_btn_hover")
theme_override_styles/focus = SubResource("SB_btn")
theme_override_styles/disabled = SubResource("SB_btn_disabled")
text = "[E] 装备"

[node name="BtnClose" type="Button" parent="Stage/Frame/Margin/VBox/Footer"]
custom_minimum_size = Vector2(0, 36)
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(0.043137, 0.047059, 0.062745, 1)
theme_override_colors/font_pressed_color = Color(0.043137, 0.047059, 0.062745, 1)
theme_override_colors/font_disabled_color = Color(0.2, 0.2, 0.2, 1)
theme_override_styles/normal = SubResource("SB_btn")
theme_override_styles/hover = SubResource("SB_btn_hover")
theme_override_styles/pressed = SubResource("SB_btn_hover")
theme_override_styles/focus = SubResource("SB_btn")
theme_override_styles/disabled = SubResource("SB_btn_disabled")
text = "[ESC] 关闭"