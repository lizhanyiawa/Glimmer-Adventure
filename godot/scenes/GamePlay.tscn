[node name="StoryBox" type="PanelContainer" parent="Root/Layout/MainViewport"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
size_flags_stretch_ratio = 65.0
theme_override_styles/panel = SubResource("SB_story")

[node name="StoryText" type="RichTextLabel" parent="Root/Layout/MainViewport/StoryBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_colors/default_color = Color(0.772549, 0.776471, 0.780392, 1)
theme_override_font_sizes/normal_font_size = 17
bbcode_enabled = true
text = "（此处为渲染层占位文本，用于检查中文排版与换行）

雾气还没散。你能听见远处有水声，像是溪流，又像是别的什么。

[color=#ffaa00]【占位】[/color]这一段用来验证 BBCode 效果。原项目里的自定义标签（<fire> / <shadow> / <ice> 等）在 Godot 中会直接映射成 BBCode： [color=#ff6666]红色[/color] 表示危险，[color=#66fcf1]青色[/color] 表示可用信息，[b]加粗[/b] 表示强调。

本段之后的长文本会自动换行并撑满故事框，滚动条在内容超出时出现。"
scroll_active = true

[node name="RightPanel" type="VBoxContainer" parent="Root/Layout/MainViewport"]
